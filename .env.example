# -----------------------------------------------------------------------------
# OutcomeOS Environment Variables Example
# Copy this file to .env and fill in your values
# -----------------------------------------------------------------------------

# Database (Supabase / Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/outcome_os?schema=public"

# Authentication (NextAuth / Auth.js)
# Generate a secret: npx auth secret
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider (Groq / OpenAI)
# Get your API key: https://console.groq.com/
GROQ_API_KEY="gsk_..."

# Development Mode
NODE_ENV="development"
